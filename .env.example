# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable (or legacy "anon") key. Safe for the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Server-only secrets (never prefix with NEXT_PUBLIC_) ---
# Signs guest invitation links. 32+ random chars. Changing it invalidates ALL existing invitation links.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
INVITE_TOKEN_SECRET=

# Optional: enables "delete my account" in Settings. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional ---
# Public URL used in invitation links (recommended in production), e.g. https://daawati.example.com
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_BRAND_NAME=دعوتي
NEXT_PUBLIC_SUPPORT_EMAIL=
